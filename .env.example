# mm-slack-cb-pr-status — every configuration knob the process reads.
# Copy to .env for local development; set the same names as env vars in prod.
# Only the uncommented variables need setting. Everything commented out shows
# its built-in default — uncomment only to change it.

# --- Slack (required) -------------------------------------------------------
# Bot token from Install App → OAuth & Permissions. Used for reactions.* calls.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token with connections:write, from Basic Information → App-Level
# Tokens. This is what opens the Socket Mode connection.
SLACK_APP_TOKEN=xapp-your-app-token

# --- GitHub (required) ------------------------------------------------------
# Fine-grained PAT with read-only "Pull requests" on the relevant repos.
# If your org uses SAML SSO, authorise the token for the org.
GITHUB_TOKEN=github_pat_your_token

# --- Optional (defaults shown) ----------------------------------------------
# Comma-separated owner/repo allowlist. Empty tracks any repo the GitHub token
# can see. Set it when channels carry links for repos outside the token's
# access: without it those links 404 on every poll and show EMOJI_UNKNOWN.
# Matched case-insensitively.
# WATCHED_REPOS=

# GitHub login of the codeowner bot. Its latest PR comment is the only source
# of approval: no comment means no :white_check_mark:.
# CODEOWNER_BOT_LOGIN=mmllc-gh

# How often to poll GitHub for tracked PRs, in seconds (minimum 10).
# POLL_INTERVAL_SECONDS=90

# How long to keep a merged/closed PR before forgetting it, in days.
# CLEANUP_TTL_DAYS=7

# How long a PR may stay unreachable (broken token, deleted repo) before the bot
# removes its reaction and stops tracking it, in days.
# UNREACHABLE_TTL_DAYS=7

# The only path this process writes to. Must be on a persistent volume, or the
# database is wiped on every redeploy. Local dev: ./data/bot.sqlite
# DATABASE_PATH=/data/bot.sqlite

# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Also scan plain message text for PR links, not just Slack's link_shared event.
# Slack suppresses link_shared for a URL recently unfurled in the same channel,
# so this is what makes re-posts reliable.
# ENABLE_MESSAGE_SCAN=true

# GitHub Enterprise Server only — e.g. https://github.example.com/api/v3
# GITHUB_API_BASE_URL=https://api.github.com

# --- Emoji (names only, no colons; set empty for no emoji on a state) -------
# Custom workspace emoji must exist before the bot can add them.
# Waiting on reviews (the codeowner bot isn't satisfied yet). Set it empty to
# leave waiting PRs with no reaction at all.
# EMOJI_NO_REVIEWS=please
# EMOJI_CHANGES_REQUESTED=request-changes
# Private channels set to a team only: "found 1 of 2 reviews", and "this team
# is done, other code owners are still pending".
# EMOJI_PARTIAL=1of2
# EMOJI_TEAM_DONE=blue_check_mark
# EMOJI_APPROVED=white_check_mark
# EMOJI_MERGED=merged
# EMOJI_CLOSED=x
# EMOJI_UNKNOWN=sleeping
