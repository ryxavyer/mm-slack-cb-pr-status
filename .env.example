# mm-slack-cb-pr-status — every configuration knob the process reads.
# Copy to .env for local development; set the same names as env vars in prod.

# --- Slack (required) -------------------------------------------------------
# Bot token from Install App → OAuth & Permissions. Used for reactions.* calls.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token with connections:write, from Basic Information → App-Level
# Tokens. This is what opens the Socket Mode connection.
SLACK_APP_TOKEN=xapp-your-app-token

# --- GitHub (required) ------------------------------------------------------
# Fine-grained PAT with read-only "Pull requests" on the relevant repos.
# If your org uses SAML SSO, authorise the token for the org.
GITHUB_TOKEN=github_pat_your_token

# --- Behaviour --------------------------------------------------------------
# Optional comma-separated owner/repo allowlist. Leave empty to track any repo
# the GitHub token can see. Set it when a watched channel might carry links for
# repos outside the token's access: without it those links get tracked, 404 on
# every poll, and show EMOJI_UNKNOWN — "I lost access" when the truth is
# "not my repo". Matched case-insensitively.
WATCHED_REPOS=acme/monolith

# Approvals needed before a PR counts as fully approved.
REQUIRED_APPROVALS=2

# How often to poll GitHub for tracked PRs, in seconds (minimum 10).
POLL_INTERVAL_SECONDS=90

# How long to keep a merged/closed PR before forgetting it, in days.
CLEANUP_TTL_DAYS=7

# How long a PR may stay unreachable (broken token, deleted repo) before the bot
# gives up: it removes its reaction and stops tracking. Until then it shows
# EMOJI_UNKNOWN and keeps polling, so fixing the token restores the real state.
UNREACHABLE_TTL_DAYS=7

# --- Emoji (names only, no colons; leave empty to use no emoji for a state) --
# Shown when nobody has approved the PR yet: "this still needs a reviewer".
# Set it empty to go back to leaving unreviewed PRs with no reaction at all.
EMOJI_NO_REVIEWS=please

# Shown when any reviewer has an outstanding changes-requested review. This
# outranks the approval count: a PR with enough approvals but someone still
# blocking is not ready to merge. Custom workspace emoji.
EMOJI_CHANGES_REQUESTED=request-changes

# Custom workspace emoji — create it first, or the add call fails. The name
# assumes REQUIRED_APPROVALS=2; change both together if that changes.
# Also shown when the approval count alone would say approved but the codeowner
# bot still lists a review group that has not signed off.
EMOJI_PARTIAL=1of2
EMOJI_APPROVED=white_check_mark
# Usually a custom workspace emoji — create it first, or the add call fails.
EMOJI_MERGED=merged
EMOJI_CLOSED=x
# Shown when GitHub won't report on a PR at all — an expired or unauthorised
# token, or a repo we lost access to. Deliberately distinct from EMOJI_CLOSED:
# "I can't see this" is not the same claim as "this was closed".
EMOJI_UNKNOWN=sleeping

# --- Storage ----------------------------------------------------------------
# The only path this process writes to. Point it at a mounted volume, or the
# database is wiped on every redeploy and every tracked PR is forgotten.
# Railway: /data/bot.sqlite   Local dev: ./data/bot.sqlite
DATABASE_PATH=/data/bot.sqlite

# --- Optional ---------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Also scan plain message text for PR links, not just Slack's link_shared event.
# Recommended: Slack suppresses link_shared for a URL recently unfurled in the
# same channel, so this is what makes re-posts reliable. Requires the
# message.channels event subscription and the channels:history scope.
ENABLE_MESSAGE_SCAN=true

# GitHub Enterprise Server only — e.g. https://github.example.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# --- Codeowners (optional) --------------------------------------------------
# Path to a JSON file identifying the codeowner bot and mapping Slack channels
# to GitHub teams. When set, the bot reads that account's status comment on each
# PR. What it does with it depends on who is reading the message.
#
# PUBLIC CHANNELS (and anywhere without a mapped team) — several teams watch
# these, so the reaction means "is this PR ready?". While any review group is
# outstanding, a PR the approval count would call approved shows EMOJI_PARTIAL
# instead. Codeowner data can only hold a PR back here, never advance it: one
# team's sign-off must not speak for the other groups reading.
#
# PRIVATE CHANNELS listed in "channels" — only that team is in the room, so the
# reaction answers "do we still owe a review?":
#   - the team's group is outstanding        -> held below approved
#   - the team's group has signed off        -> EMOJI_APPROVED, even on a single
#                                               approval, as long as some other
#                                               group is left to meet the count
#   - signed off, count short, no other group left to meet it
#                                            -> EMOJI_PARTIAL; the next approval
#                                               has to come from this team
#   - the team owns none of the changed files -> the approval count alone; all
#                                               they can owe is a +1 towards it
#
# Privacy is read from channel_type on Slack message events, so a channel is
# only known once a message has been seen in it; until then it is treated as
# public. This needs ENABLE_MESSAGE_SCAN=true (the default) — link_shared does
# not carry channel_type.
#
# Unset this and the bot never fetches comments: emoji come from the approval
# count alone.
#
# File format:
# {
#   "botLogin": "mmllc-gh",
#   "channels": { "C123456": "monetization-team" }
# }
#
# "channels" maps a PRIVATE Slack channel ID → GitHub team slug. An entry for a
#            public channel has no effect, so list only private ones.
# Railway: /app/team-map.json (baked into image)   Local dev: ./team-map.json
TEAM_MAP_FILE=/app/team-map.json
