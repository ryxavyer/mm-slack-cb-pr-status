{
  "name": "mm-slack-cb-pr-status",
  "version": "1.0.0",
  "private": true,
  "description": "Slack bot that keeps an emoji on GitHub PR links reflecting the PR's review state",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.45.2",
    "octokit": "^4.1.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
